# =====================================================================
#  Our Forever — Ademilson & Regiane
#  Copie este arquivo para ".env" (na raiz do projeto) e preencha.
#  NUNCA versione o arquivo .env.
# =====================================================================

# ---------------------------------------------------------------------
#  SERVIDOR (backend Node.js) — valores secretos ficam APENAS aqui
# ---------------------------------------------------------------------
PORT=3001
# Em produção atrás de proxy (Render, Railway, Nginx...), use 1
TRUST_PROXY=0
# Origens autorizadas a chamar a API (separadas por vírgula).
# Necessário apenas quando frontend e backend estão em domínios diferentes.
# Ex.: https://nossocasamento.com.br,https://www.nossocasamento.com.br
ALLOWED_ORIGINS=
# true = o backend também serve o frontend compilado (client/dist)
SERVE_CLIENT=false

# --- SMTP (envio do e-mail de RSVP) ---
SMTP_HOST=
SMTP_PORT=587
# true para porta 465 (SSL/TLS); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# E-mail REAL dos noivos (pode ser mais de um, separados por vírgula).
# Configure antes de publicar.
RSVP_RECIPIENT_EMAIL=
# Remetente — normalmente o mesmo endereço autenticado no SMTP
RSVP_SENDER_EMAIL=

# --- Regras do RSVP ---
# Permitir que o convidado informe acompanhantes?
RSVP_ALLOW_COMPANIONS=false
# Limite de acompanhantes por convite (usado quando o item acima for true)
RSVP_MAX_COMPANIONS=2

# --- Armazenamento das respostas ---
# "mysql" (banco da Hostinger — recomendado em produção) ou "file" (server/data/rsvps.jsonl).
# Se vazio: usa mysql quando DB_HOST, DB_USER e DB_NAME existirem; senão, file.
STORAGE_DRIVER=
# MySQL da Hostinger (hPanel → Bancos de dados → Gerenciamento).
# App Node.js hospedado na própria Hostinger: DB_HOST=127.0.0.1
# Acesso de fora da Hostinger: host srvNNNN.hstgr.io + "MySQL remoto" liberado no hPanel.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_TABLE=rsvps
# true para exigir conexão TLS (útil em acesso remoto)
DB_SSL=false

# --- Proteção contra abuso ---
# Máximo de envios de RSVP por IP dentro da janela (minutos)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15

# ---------------------------------------------------------------------
#  FRONTEND (Vite) — tudo que começa com VITE_ fica PÚBLICO no navegador.
#  Nunca coloque segredos em variáveis VITE_.
# ---------------------------------------------------------------------
# URL do backend quando hospedado separadamente (sem barra no final).
# Deixe vazio quando o mesmo domínio servir frontend e /api.
VITE_API_URL=

# Trilha sonora — URL de um arquivo de áudio LICENCIADO/AUTORIZADO (mp3/m4a).
# Ex.: /audio/trilha.mp3 (arquivo em client/public/audio) ou https://.../trilha.mp3
# Vazio = o convite funciona normalmente, sem música e sem botão de áudio.
VITE_AUDIO_SRC=
# Crédito exibido discretamente no rodapé (ex.: Photograph — Ed Sheeran)
VITE_AUDIO_TITLE=

# Opcional: player oficial do Spotify no rodapé (ex.: https://open.spotify.com/track/XXXX)
VITE_SPOTIFY_TRACK_URL=
